{
  "manifest_version": 3,
  "name": "CP Train Watcher",
  "version": "5.6",
  "description": "Retries a CP.pt booking for one or more departure times and alerts via ntfy the moment a seat is actually secured.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://ntfy.sh/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cp.pt/*", "https://www.cp.pt/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://cp.pt/*", "https://www.cp.pt/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
